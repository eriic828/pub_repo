{
  "skill_name": "斑码AI选题雷达",
  "version": "3.8.0",
  "evals": [
    {
      "id": 1,
      "name": "daily-push-mode",
      "prompt": "AI选题",
      "description": "测试每日推送模式的完整执行流程",
      "expected_output": "应该生成包含10个选题的完整报告，每个选题包含综合评分、来源、标题建议、原文链接",
      "assertions": [
        {
          "type": "contains",
          "value": "热点词聚合过程",
          "description": "必须展示热点词聚合过程"
        },
        {
          "type": "contains",
          "value": "来源A",
          "description": "必须展示GitHub Trending直采的来源A"
        },
        {
          "type": "contains",
          "value": "来源B",
          "description": "必须展示GitHub API AI热门的来源B"
        },
        {
          "type": "contains",
          "value": "来源C",
          "description": "必须展示GitHub API最近更新的来源C"
        },
        {
          "type": "contains",
          "value": "来源D",
          "description": "必须展示Hacker News Top的来源D"
        },
        {
          "type": "contains",
          "value": "搜索结果统计",
          "description": "必须展示搜索结果数量统计"
        },
        {
          "type": "regex",
          "value": "累计.*\\d+条",
          "description": "必须展示累计有效结果数"
        },
        {
          "type": "regex",
          "value": "#\\d+.*综合评分.*\\d+分",
          "description": "每个选题必须有编号和综合评分"
        },
        {
          "type": "contains",
          "value": "原文链接",
          "description": "每个选题必须包含原文链接"
        },
        {
          "type": "contains",
          "value": "Sources:",
          "description": "报告末尾必须有Sources部分"
        }
      ]
    },
    {
      "id": 2,
      "name": "quick-find-mode",
      "prompt": "选题：Claude Code 教程",
      "description": "测试快速查找模式的执行流程",
      "expected_output": "应该生成与Claude Code教程相关的10个选题",
      "assertions": [
        {
          "type": "contains",
          "value": "Claude",
          "description": "选题应与Claude相关"
        },
        {
          "type": "contains",
          "value": "综合评分",
          "description": "必须有综合评分"
        },
        {
          "type": "contains",
          "value": "原文链接",
          "description": "必须有原文链接"
        },
        {
          "type": "regex",
          "value": "公式 [ABC].*:",
          "description": "每个选题必须提供3个标题公式示例"
        }
      ]
    },
    {
      "id": 3,
      "name": "search-failure-handling",
      "prompt": "选题：xyzabc123不存在的关键词测试",
      "description": "测试搜索结果不足时的处理",
      "expected_output": "当搜索结果不足时，应提示用户而非编造内容",
      "assertions": [
        {
          "type": "any_of",
          "values": [
            "搜索结果不足",
            "建议稍后重试",
            "候选内容",
            "有效结果",
            "搜索结果有限"
          ],
          "description": "应在搜索失败时给出明确提示"
        }
      ]
    },
    {
      "id": 4,
      "name": "output-format-compliance",
      "prompt": "每日推送",
      "description": "测试输出格式是否符合规范",
      "expected_output": "输出格式应符合output-template.md规范",
      "assertions": [
        {
          "type": "regex",
          "value": "📅 \\d{4}-\\d{2}-\\d{2}",
          "description": "日期格式应为YYYY-MM-DD"
        },
        {
          "type": "contains",
          "value": "📍",
          "description": "来源标识应使用📍"
        },
        {
          "type": "regex",
          "value": "【综合评分：\\d+分】",
          "description": "综合评分应使用【】包裹"
        },
        {
          "type": "regex",
          "value": "⭐{1,3}",
          "description": "星级应使用1-3个⭐"
        }
      ]
    },
    {
      "id": 5,
      "name": "scoring-engine-validation",
      "prompt": "选题：AI赚钱",
      "description": "测试评分引擎是否正确工作",
      "expected_output": "评分应合理，高分选题应具有明确的爆款要素",
      "assertions": [
        {
          "type": "contains",
          "value": "爆款要素",
          "description": "必须展示爆款要素分析"
        },
        {
          "type": "contains",
          "value": "数据震撼力",
          "description": "必须包含数据震撼力维度"
        },
        {
          "type": "contains",
          "value": "情绪共鸣",
          "description": "必须包含情绪共鸣维度"
        },
        {
          "type": "contains",
          "value": "关键词匹配",
          "description": "必须展示关键词匹配分析"
        }
      ]
    },
    {
      "id": 6,
      "name": "tavily-api-key-reminder",
      "prompt": "AI选题",
      "description": "测试Tavily API Key强提醒（当websearch不可用时）",
      "expected_output": "当websearch不可用且Tavily未配置时，应显示醒目提醒",
      "assertions": [
        {
          "type": "any_of",
          "values": [
            "Tavily API Key 未配置",
            "设置Tavily API Key",
            "tvly-",
            "tavily.com"
          ],
          "description": "未配置时应提醒用户配置Tavily API Key"
        }
      ]
    },
    {
      "id": 7,
      "name": "valid-results-50",
      "prompt": "AI选题",
      "description": "测试有效结果统计是否展示",
      "expected_output": "必须展示累计有效结果数量，目标≥50条",
      "assertions": [
        {
          "type": "regex",
          "value": "累计.*\\d+条",
          "description": "必须展示累计有效结果数"
        },
        {
          "type": "contains",
          "value": "搜索结果统计",
          "description": "必须展示搜索结果统计表格"
        }
      ]
    },
    {
      "id": 8,
      "name": "hot-keywords-complete-display",
      "prompt": "AI选题",
      "description": "测试热点词聚合过程是否完整展示",
      "expected_output": "必须展示 GitHub API AI热门项目的完整列表，禁止省略",
      "assertions": [
        {
          "type": "contains",
          "value": "热点词聚合过程",
          "description": "必须展示热点词聚合过程标题"
        },
        {
          "type": "contains",
          "value": "GitHub API AI热门",
          "description": "必须展示 GitHub API AI热门来源"
        },
        {
          "type": "regex",
          "value": "\\d+\\.\\s*\\[?\\w+",
          "description": "必须列出具体的项目名称"
        },
        {
          "type": "contains",
          "value": "最终热点词",
          "description": "必须展示最终热点词列表"
        }
      ]
    }
  ]
}